@page "/crudops" 
@using Microsoft.EntityFrameworkCore 
@using MyApp.Server.Models 
@using MyApp.Server.Components.IntOps
@inject AppDbContext Db 

@inject IJSRuntime JS
@inject AuthService Auth

@rendermode InteractiveServer

<div class="text-left mb-4">
    <h3 class="fw-bold text-primary">Department</h3>
    <hr class="border-primary" />
</div>
<div class="mb-3">



    @if (!string.IsNullOrEmpty(dbWake))
    {
        <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
            @dbWake
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
            @statusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    
    <hr />  


</div>

@if (departments.Count == 0)
{

    <table class="w-100">
        <tbody>
            <tr>
                <td colspan="3" >
                    No departments record found — try adding a new one!
                </td>
                <td align="center" width="150">
                    <button class="btn btn-success " @onclick="ShowAddModal">
                        <i class="bi bi-plus-lg"></i>New Dept.
                    </button>


                </td>
            </tr>

        </tbody>

    </table>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th>Status</th>
                <th style="width:150px; text-align:center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in departments)
            {
                <tr>
                    <td>@department.DId</td>

                    <!-- Editable only if in edit mode -->
                    <td>
                        @if (editDepartmentId == department.DId)
                        {
                            <input @bind="tempEditDepartment.DName" class="form-control" />
                        }
                        else
                        {
                            @department.DName
                        }
                    </td>
                    <td>
                        @if (editDepartmentId == department.DId)
                        {
                            <!-- Editable as dropdown -->
                            <select class="form-select" @bind="tempEditDepartment.DStats">
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        }
                        else
                        {
                            <!-- Display as badge -->
                            @if (department.DStats == 1)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        }
                    </td>

                    <td align="center">
                        @if (editDepartmentId == department.DId)
                        {
              
                            <button class="btn btn-warning btn-sm me-1" title="Update" @onclick="() => ConfirmUpdate(department)">
                                <i class="bi bi-check-lg"></i>
                            </button>

                  
                            <button class="btn btn-secondary btn-sm me-1" title="Cancel" @onclick="CancelEdit">
                                <i class="bi bi-x-lg"></i>
                            </button>


                            <button class="btn btn-danger btn-sm" title="Delete" @onclick="() => ConfirmDelete(department)">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" title="Edit" @onclick="() => StartEdit(department.DId)">
                                <i class="bi bi-pencil"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
            <tr>
                <td colspan="3"  style="text-align:right">
                </td>
                <td align="center">
                    <button class="btn btn-success " @onclick="ShowAddModal">
                        <i class="bi bi-plus-lg"></i>New Dept.
                    </button>


                </td>
            </tr>
        </tbody>

    </table>
}

<!-- Add Department Modal -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1" aria-labelledby="addDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addDepartmentModalLabel">Add Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="departmentName" class="form-label">Department Name</label>
                    <input id="departmentName" @bind="newDepartmentName" @bind:event="oninput" placeholder="Enter department name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="departmentStatus" class="form-label">Status</label>
                    <select id="departmentStatus" class="form-select" @bind="newDepartmentStatus">
                        <option value="1">Active</option>
                        <option value="0">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="@(() => SetStatusMessageOnCancel())">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="AddDepartment">Add</button>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="mb-4 p-3 border rounded bg-light">
    <h5 class="text-primary mb-2">Quick Reference</h5>

    <ul class="list-group list-group-flush mb-3">
        <li class="list-group-item"><span class="badge  text-dark me-2" style="background-color:#a3cfbb">Page Load > Read</span> Retrieve and display records from the database.</li>
        <li class="list-group-item"><span class="badge bg-success me-2">+ New Dept.</span> Add new records to the database.</li>

        <li class="list-group-item"><span class="badge bg-warning text-dark me-2">Action >Edit > Update</span> Modify existing records in the database.</li>
        <li class="list-group-item"><span class="badge bg-danger me-2">Action > Edit > Delete</span> Remove records from the database.</li>
    </ul>

</div>



@code {

    private Department tempEditDepartment = new Department();

    private ValueTask ToastSuccess(string msg) =>
        JS.InvokeVoidAsync("toastSuccess", msg);

    private ValueTask ToastWarning(string msg) =>
        JS.InvokeVoidAsync("toastWarning", msg);

    private async Task ShowAddModal()
    {
        statusMessage = "Preparing to add a new database record.";
        await JS.InvokeVoidAsync("showModal", "addDepartmentModal");
    }

    private void SetStatusMessageOnCancel()
    {
        if (departments.Count == 0)
        {
            statusMessage = "No department records were found.";
        }
        else
        {   statusMessage = "Action cancelled."; }
     
    }


        private List<Department> departments = new(); 
    private string newDepartmentName = string.Empty; 
 private int newDepartmentStatus = 0; // default as inactive
    private string statusMessage = string.Empty; 
    private string dbWake = string.Empty;

    private void OnInputChanged(ChangeEventArgs e) { 
        statusMessage = $"Current input: {e.Value}"; } 
    private int currentCount = 0; 
    private void IncrementCount() { currentCount++; } 
   
     private bool firstRender = true;
  
        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                await LoadDepartments();
                StateHasChanged();
            }
        }


    private int editDepartmentId = -1; // -1 means no row is being edited

    private void StartEdit(int id)
    {
        editDepartmentId = id;


        var dept = departments.First(d => d.DId == id);
        tempEditDepartment = new Department
        {
            DId = dept.DId,
            DName = dept.DName,
            DStats = dept.DStats
        };
        
        statusMessage = "You’re now managing " + dept.DName + " department.";

    }

    private void CancelEdit()
    {
        editDepartmentId = -1;
     tempEditDepartment = new Department();
    }




    private async Task LoadDepartments() { 
      

        try
        {
            departments = await Db.Departments.FromSqlRaw("EXEC GetDepartments").ToListAsync();

            statusMessage = departments.Count == 0
                ? "No department records found."
                : "Departments loaded successfully.";

            dbWake = string.Empty; 
        }
        catch (Exception ex)
        {
            var friendly = GetFriendlyDbErrorMessage(ex);     
            dbWake = friendly;
  
        }



    } 
    private async Task AddDepartment() { 

  ;

        if (string.IsNullOrWhiteSpace(newDepartmentName))
        {
            await ToastWarning("Department name is required!");
            return;
        }

        var department = new Department
        {
            DName = newDepartmentName,
            DStats = newDepartmentStatus
        };

        Db.Departments.Add(department);
        await Db.SaveChangesAsync();

        newDepartmentName = string.Empty;
        newDepartmentStatus = 1;

        await LoadDepartments();
        await JS.InvokeVoidAsync("hideModal", "addDepartmentModal");
        await ToastSuccess("The department has been added to the system.");
        StateHasChanged();
    } 

    private async Task UpdateDepartment(Department department) {  
        try
        {
            await Db.Database.ExecuteSqlInterpolatedAsync($"EXEC UpdateDepartment @DId={department.DId}, @DepartmentName={department.DName}, @DStats={department.DStats}");
            editDepartmentId = -1;
            await ToastSuccess("Department updated successfully!");
            await LoadDepartments();

            statusMessage = $"{department.DName} was successfully updated.";
            dbWake = string.Empty;
        }
        catch (Exception ex)
        {

            var friendly = GetFriendlyDbErrorMessage(ex);
            dbWake = friendly;
          //  await ToastWarning(friendly);

        }
   


    } 
    
    private async Task DeleteDepartment(Department department)
    {
        try
        {

            await Db.Database.ExecuteSqlInterpolatedAsync( $"EXEC DeleteDepartment @DId={department.DId}");
            await ToastSuccess("Department deleted successfully!");
            await LoadDepartments();
            statusMessage = $"{department.DName} was successfully deleted.";
            dbWake = string.Empty;
        }
        catch (Exception ex)
        {
            var friendly = GetFriendlyDbErrorMessage(ex);
            dbWake = friendly;
            //await ToastWarning(friendly);
        }
    }



    private async Task ConfirmDelete(Department department)
    {
  
        bool confirmed = await JS.InvokeAsync<bool>("showConfirm", "Delete Department", "Are you sure you want to delete " + department.DName + " department?");
        if (confirmed)
        {
            await DeleteDepartment(department);
        }
    }

    private async Task ConfirmUpdate(Department department)
    {
        bool confirmed = await JS.InvokeAsync<bool>("showConfirm", "Update Department", "Are you sure you want to save changes?");
        if (confirmed)
        {

            department.DName = tempEditDepartment.DName;
            department.DStats = tempEditDepartment.DStats;

           await  UpdateDepartment(department);
        }


    }


    private string GetFriendlyDbErrorMessage(Exception ex)
    {
        if (ex.InnerException?.Message.Contains("timeout", StringComparison.OrdinalIgnoreCase) == true ||
            ex.Message.Contains("timeout", StringComparison.OrdinalIgnoreCase))
        {
            return "Database is asleep or not responding. Please wait a few seconds and try again.";
        }

        if (ex.InnerException?.Message.Contains("paused", StringComparison.OrdinalIgnoreCase) == true ||
            ex.Message.Contains("paused", StringComparison.OrdinalIgnoreCase))
        {
            return "Database is currently paused. Waking up the server… please retry shortly.";
        }

        return "A database error occurred. Please try again.";
    }

}