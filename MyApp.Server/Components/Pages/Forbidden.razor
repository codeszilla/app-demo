@using MyApp.Server.Components.Layout
@page "/forbidden"

@layout SplashLayout



<div class="container text-center my-5 py-5">
    <h1 class="display-1 text-danger fw-bold">403</h1>
    <h2 class="fw-semibold">Access Denied</h2>
    <p class="text-muted">You do not have permission to view this app.</p>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }
}